      "sources": {
        "prs": {
          "kind": "tool",
          "id": "prs",
          "connection": "github",
          "tool": "search_pull_requests",
          "args": { "query": "is:open is:pr org:acme" },
          "normalize": "items.{ \"number\": number, \"repo\": $split(repository_url, \"/\")[-1], \"title\": title, \"author\": user.login, \"url\": html_url, \"ci\": ci, \"diff\": \"+\" & $string(additions) & \" −\" & $string(deletions), \"updated\": updated_at }",
