          "schema": {}
        }
      },
      "blocks": {
        "prs-summary": {
          "id": "prs-summary",
          "page": "home",
          "slot": "main",
          "order": 0,
          "title": "Overview",
          "frame": { "sources": false, "freshness": false },
          "inputs": { "prs": "prs" },
          "view": { "expr": "{ \"open\": $count($prs), \"failing\": $count($prs[ci = \"failing\"]), \"passing\": $count($prs[ci = \"passing\"]) }", "schema": {} },
          "ui": {},
          "root": "stats",
          "nodes": {
            "stats": { "type": "Stack", "props": { "direction": "row", "gap": "lg" }, "children": ["s1", "s2", "s3"] },
            "s1": { "type": "Stat", "props": { "label": "Open PRs", "value": { "path": "/open" } } },
            "s2": { "type": "Stat", "props": { "label": "CI passing", "value": { "path": "/passing" } } },
            "s3": { "type": "Stat", "props": { "label": "CI failing", "value": { "path": "/failing" } } }
          }
        },
        "prs-table": {
          "id": "prs-table",
          "page": "home",
          "slot": "main",
          "order": 1,
          "title": "Open pull requests",
          "inputs": { "prs": "prs" },
          "view": { "expr": "{ \"rows\": $prs }", "schema": {} },
          "ui": { "showDiff": true },
          "toolbar": "tb",
          "root": "t",
          "nodes": {
            "tb": { "type": "Checkbox", "props": { "label": "Show diff", "bind": "/ui/showDiff" } },
            "t": {
              "type": "DataTable",
              "props": { "rows": { "path": "/rows" }, "rowKey": "url" },
              "children": ["c1", "c2", "c3", "c4", "c5"],
              "action": { "name": "intent", "params": { "id": "pr-details", "prompt": "Show this pull request's details" } }
            },
            "c1": { "type": "DataColumn", "props": { "header": "Title", "field": "title", "subField": "repo" } },
            "c2": { "type": "DataColumn", "props": { "header": "Author", "field": "author" } },
            "c3": { "type": "DataColumn", "props": { "header": "CI" }, "children": ["ok", "bad"] },
            "ok": { "type": "Badge", "props": { "text": "passing", "variant": "success" }, "visible": { "eq": [{ "path": "$item/ci" }, "passing"] } },
            "bad": { "type": "Badge", "props": { "text": "failing", "variant": "error" }, "visible": { "eq": [{ "path": "$item/ci" }, "failing"] } },
            "c4": { "type": "DataColumn", "props": { "header": "Diff", "field": "diff" }, "visible": { "path": "/ui/showDiff" } },
            "c5": { "type": "DataColumn", "props": { "header": "Updated", "field": "updated", "format": "relative", "align": "right" } }
          }
        }
      }
    },
